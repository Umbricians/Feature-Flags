{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [ "ES2020", "DOM", "DOM.Iterable" ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [ "@umbraco-cms/backoffice/extension-types", "node" ]
  },
  // The declarations, plus the checks that they match the client's own types.
  "include": [ "index.d.ts", "test/*.ts" ]
}
