{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "93d57686-3aa9-4872-b1d9-6fbf464215db"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  },
  "Umbricians": {
    "FeatureFlags": {}
  },
  "feature_management": {
    "feature_flags": [
      {
        "id": "Checkout.NewFlow",
        "enabled": false,
        "description": "The redesigned checkout.",
        "tags": [
          "beta"
        ]
      },
      {
        "id": "Checkout.ExpressPay",
        "enabled": false,
        "description": "One-click payment for returning members.",
        "tags": [
          "payments",
          "beta"
        ]
      },
      {
        "id": "Checkout.GiftCards",
        "enabled": true,
        "description": "Pay with a gift card.",
        "tags": [
          "payments"
        ]
      },
      {
        "id": "Search.BetaSearch",
        "enabled": true,
        "description": "Search that understands plain questions.",
        "conditions": {
          "client_filters": [
            {
              "name": "Microsoft.Targeting",
              "parameters": {
                "Audience": {
                  "Groups": [
                    {
                      "Name": "Beta testers",
                      "RolloutPercentage": 100
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      {
        "id": "Search.Suggestions",
        "enabled": true,
        "description": "Suggest searches while typing."
      },
      {
        "id": "Members.NewProfilePage",
        "enabled": false,
        "description": "The new member profile page."
      },
      {
        "id": "Promo.WinterSale",
        "enabled": true,
        "description": "The winter sale banner. Uses a time window, so it's read-only in the backoffice.",
        "conditions": {
          "client_filters": [
            {
              "name": "Microsoft.TimeWindow",
              "parameters": {
                "Start": "Mon, 01 Dec 2026 00:00:00 GMT",
                "End": "Thu, 01 Jan 2027 00:00:00 GMT"
              }
            }
          ]
        }
      }
    ]
  }
}
