<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>$(UmbracoTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Nothing here needs Razor views compiled, and the models are never generated. -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <!-- As in Umbraco's site template: Umbraco's backoffice files come compressed, and SDK 11 fails compressing them again. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umbricians.FeatureFlags\Umbricians.FeatureFlags.csproj" />
  </ItemGroup>
</Project>
