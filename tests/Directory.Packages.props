<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Microsoft.Data.SqlClient for the integration tests: at least the version each major's lowest Umbraco brings in. A newer Umbraco may bring a
         newer one, which would be a package downgrade (NU1605), so the "Umbraco minors" workflow passes the newest with -p:SqlClientVersion=. -->
    <SqlClientVersion Condition="'$(SqlClientVersion)' == ''">7.1.2</SqlClientVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageVersion Include="Umbraco.Cms.Persistence.Sqlite" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="$(SqlClientVersion)" />
  </ItemGroup>
</Project>
